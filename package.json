    "@vitejs/plugin-react": "^5.0.4",
    "body-parser": "^2.2.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "gantt-task-react": "^0.3.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-is": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.0",
