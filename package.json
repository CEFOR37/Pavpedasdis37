{
  "name": "outil-collaboratif-pavillon-pedagogique",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --outfile=dist/server.js",
    "build": "vite build && npm run build:server",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build:client": "vite build",
    "build:netlify": "vite build",
    "check": "npm run lint && npm audit && npm run build:client"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
