rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isValidDocumentFile() {
      return request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|application/vnd.openxmlformats-officedocument.*|application/msword|application/vnd.ms-excel|text/csv');
    }

    match /documents/{allPaths=**} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidDocumentFile();
      allow update: if false;
      allow delete: if isSignedIn();
    }
  }
}
